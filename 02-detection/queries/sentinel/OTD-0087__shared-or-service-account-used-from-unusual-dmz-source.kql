// OTD-0087 - Shared or Service Account Used From Unusual DMZ Source
// Source: 02-detection/sigma/it-dmz-ot-crosszone/09_shared-or-service-account-used-from-unusual-dmz-source.yml
// ATT&CK for ICS: attack.ics.t0859
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
SecurityEvent
| where (EventID == 4624 and TargetUserName == "shared_service_accounts")
| where not ((WorkstationName == "documented_jump_path_for_account"))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
