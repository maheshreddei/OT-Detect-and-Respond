// OTD-0138 - Dormant Vendor Account First-Use After Extended Inactivity
// Source: 02-detection/sigma/advisory/16_dormant-vendor-account-first-use-after-extended-inactivity.yml
// ATT&CK for ICS: attack.ics.t0859
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
SigninLogs
| where (account_type in ("vendor", "commissioning") and auth_result == "success")
| where not ((days_since_last_login == 180))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
