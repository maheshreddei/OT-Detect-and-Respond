// OTD-0132 - Password Spray Against Cloud Identity Tenant Serving OT-Adjacent Accounts
// Source: 02-detection/sigma/advisory/10_password-spray-against-cloud-identity-tenant-serving-ot-adja.yml
// ATT&CK for ICS: n/a
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
SigninLogs
| where (ResultType in ("50126", "50053") and UserPrincipalName == "ot_engineering_staff_upns")
| summarize Count = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SourceIP, DestinationIP // original Sigma timeframe: 30m
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
