// OTD-0110 - Credential Harvesting Tool Execution on Engineering or SCADA Host
// Source: 02-detection/sigma/threat-actor/08_credential-harvesting-tool-execution-on-engineering-or-scada.yml
// ATT&CK for ICS: attack.ics.t0859
// Severity: critical
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
SecurityEvent
| where ((NewProcessName contains "mimikatz" or NewProcessName contains "lazagne")) and (TargetImage == "\lsass.exe" and GrantedAccess == "0x1010")
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
