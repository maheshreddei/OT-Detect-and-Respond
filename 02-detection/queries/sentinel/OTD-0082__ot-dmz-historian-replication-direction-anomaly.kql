// OTD-0082 - OT DMZ Historian Replication Direction Anomaly
// Source: 02-detection/sigma/it-dmz-ot-crosszone/03_ot-dmz-historian-replication-direction-anomaly.yml
// ATT&CK for ICS: attack.ics.t0886, attack.ics.t0840
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
CommonSecurityLog
| where (src_zone == "OT_DMZ" and dst_zone == "IT" and SourceIP == "dmz_historian_ips")
| where not ((timeframe_minute in (0, 5)))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
