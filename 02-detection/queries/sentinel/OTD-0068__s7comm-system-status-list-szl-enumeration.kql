// OTD-0068 - S7comm System Status List (SZL) Enumeration
// Source: 02-detection/sigma/ot-ics-soc/15_s7comm-system-status-list-szl-enumeration.yml
// ATT&CK for ICS: attack.ics.t0888, attack.ics.t0846
// Severity: medium
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
OTNetwork_CL
| where (Protocol == "s7comm" and Rosctr == "Userdata" and function_group == "CPU functions" and subfunction == "Read SZL")
| summarize Count = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SourceIP, DestinationIP // original Sigma timeframe: 10m
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
