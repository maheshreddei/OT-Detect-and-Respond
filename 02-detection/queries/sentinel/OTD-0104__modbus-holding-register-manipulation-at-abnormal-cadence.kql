// OTD-0104 - Modbus Holding Register Manipulation at Abnormal Cadence
// Source: 02-detection/sigma/threat-actor/02_modbus-holding-register-manipulation-at-abnormal-cadence.yml
// ATT&CK for ICS: attack.ics.t0855, attack.ics.t0836
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
OTNetwork_CL
| where (Protocol == "modbus" and FunctionCode in (6, 16))
| summarize Count = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SourceIP, DestinationIP // original Sigma timeframe: 5m
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
