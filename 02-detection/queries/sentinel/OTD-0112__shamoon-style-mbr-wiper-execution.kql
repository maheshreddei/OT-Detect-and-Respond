// OTD-0112 - Shamoon-Style MBR Wiper Execution
// Source: 02-detection/sigma/threat-actor/10_shamoon-style-mbr-wiper-execution.yml
// ATT&CK for ICS: attack.ics.t0826
// Severity: critical
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
SecurityEvent
| where ((CommandLine contains "\\.\PhysicalDrive"))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
