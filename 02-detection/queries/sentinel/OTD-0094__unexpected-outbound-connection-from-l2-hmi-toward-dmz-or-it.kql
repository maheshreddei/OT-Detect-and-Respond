// OTD-0094 - Unexpected Outbound Connection from L2 HMI Toward DMZ or IT
// Source: 02-detection/sigma/it-dmz-ot-crosszone/16_unexpected-outbound-connection-from-l2-hmi-toward-dmz-or-it.yml
// ATT&CK for ICS: attack.ics.t0886
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
CommonSecurityLog
| where (src_zone == "L2_HMI" and dst_zone in ("OT_DMZ", "IT"))
| where not ((DestinationIP == "approved_l2_outbound_destinations"))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
