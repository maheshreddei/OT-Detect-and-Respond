// OTD-0097 - Setpoint Change Exceeding Safe Delta Threshold
// Source: 02-detection/sigma/it-dmz-ot-crosszone/21_setpoint-change-exceeding-safe-delta-threshold.yml
// ATT&CK for ICS: attack.ics.t0836, attack.ics.t0855
// Severity: high
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
OTNetwork_CL
| where ((node_id startswith "Setpoint."))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
