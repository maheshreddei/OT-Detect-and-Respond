// OTD-0071 - IEC 60870-5-104 Clock Synchronization Command Anomaly
// Source: 02-detection/sigma/ot-ics-soc/18_iec-60870-5-104-clock-synchronization-command-anomaly.yml
// ATT&CK for ICS: attack.ics.t0804, attack.ics.t0851
// Severity: low
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
OTNetwork_CL
| where (Protocol == "iec104" and TypeId == "C_CS_NA_1")
| summarize Count = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by SourceIP, DestinationIP // original Sigma timeframe: 1h
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
