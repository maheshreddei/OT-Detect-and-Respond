// OTD-0120 - Safety Controller Key-Switch or Mode Change Outside Proof-Test Window
// Source: 02-detection/sigma/threat-actor/18_safety-controller-key-switch-or-mode-change-outside-proof-te.yml
// ATT&CK for ICS: attack.ics.t0858, attack.ics.t0800
// Severity: critical
// PLACEHOLDERS in <angle brackets> must be baselined before use.
//
OTNetwork_CL
| where (Protocol == "tristation" and mode_change == "PROGRAM")
| where not ((change_ticket_active == true))
| project TimeGenerated, SourceIP, DestinationIP, Protocol, FunctionCode, AccountName, Computer
| order by TimeGenerated desc
